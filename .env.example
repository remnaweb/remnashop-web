# RemnaShop API (обязательно). В Docker-сети RemnaShop: http://remnashop:5000
REMNASHOP_URL=http://remnashop:5000

# Username бота без @ — для Login Widget в браузере
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=myvpnbot

# Название в шапке кабинета и в письмах
NEXT_PUBLIC_BRAND_NAME=My VPN

# Ссылка на поддержку (кнопка во вкладке помощи)
# NEXT_PUBLIC_SUPPORT_LINK=https://t.me/mysupport

# --- Письма: регистрация и сброс пароля ---
# Нужен один из вариантов: Resend (проще) или свой SMTP.
# Без этого вход по Telegram работает, а регистрация/сброс по почте — нет.
MAIL_FROM=noreply@yourdomain.com

# Вариант 1. Resend (https://resend.com) — рекомендуем
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=My VPN <noreply@yourdomain.com>

# Вариант 2. Свой SMTP (Timeweb, Beget, Yandex, Google Workspace…)
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=change_me

# Контейнеры RemnaShop на том же хосте (сброс пароля / флаг оплаты для Telegram)
REMNASHOP_PG_CONTAINER=remnashop-db
REMNASHOP_APP_CONTAINER=remnashop
REMNASHOP_PG_DATABASE=remnashop
REMNASHOP_PG_USER=remnashop

# Telegram ID админов через запятую (если роль в БД не подтянулась)
# WEB_THEME_ADMIN_IDS=123456789

# Docker-сеть бота (docker inspect remnashop). Часто remnashop или remnawave-network
REMNASHOP_DOCKER_NETWORK=remnashop

# Порт веб-морды (docker compose)
WEB_PORT=3006
